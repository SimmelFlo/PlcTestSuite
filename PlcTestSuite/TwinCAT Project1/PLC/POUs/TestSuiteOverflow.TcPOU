<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TestSuiteOverflow" Id="{d4e5f6a7-8b9c-4d0e-8f1a-2b3c4d5e6f70}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM TestSuiteOverflow
VAR
    TestSuiteOverFlow : TestSuite<2>(ResultFile := JUnitResultFile);
	ReRun		   : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestSuiteOverflow.TestSuiteName := 'Overflow Test-Suite';

Test_TestSuiteOverflow();
Test_TestInstanceOverflow();

IF ReRun THEN
	TestSuiteOverFlow.ReRunTests();
	ReRun := FALSE;
END_IF]]></ST>
    </Implementation>
    <Method Name="Test_TestInstanceOverflow" Id="{e5f6a7b8-9c0d-4e1f-8a2b-3c4d5e6f7081}">
      <Declaration><![CDATA[METHOD Test_TestInstanceOverflow
VAR_INST
	// Junk instances only used to demonstrate/verify the overflow messages - their XML
	// output is not meant to be inspected by a user, so it is kept out of TEST_Result.xml.
	JunkResultFile : JUnitResultFile<2>('C:\ProgramData\Beckhoff\TwinCAT\3.1\Boot\TEST_InstanceOverflow_Result.xml');
	JunkTestSuite  : TestSuite<2>(ResultFile := JunkResultFile);

	Expected : BOOL;
	Actual	 : BOOL;
END_VAR
VAR
    i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    JunkTestSuite.TestSuiteName := 'Junk Test Instance Overflow';

	// JunkTestSuite<2> only has capacity for 3 tests; a 4th distinct test id forces
	// TestSuite.Test() to hit its "Out of tests" branch and increment TestOverflowCount.
	FOR i := 0 TO 4 DO
		JunkTestSuite.Test(CONCAT('JunkTest_', TO_STRING(i))).ExecuteTest();
	END_FOR

	Expected := TRUE;
	Actual	 := JunkTestSuite.TestOverflowCount > 0;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_TestSuiteOverflow" Id="{ca30fac0-c870-4580-8e53-0050bcf2e07c}">
      <Declaration><![CDATA[METHOD Test_TestSuiteOverflow
VAR_INST
    // Junk instances only used to demonstrate/verify the overflow messages - their XML
	// output is not meant to be inspected by a user, so it is kept out of TEST_Result.xml.
	JunkResultFile : JUnitResultFile<2>('C:\ProgramData\Beckhoff\TwinCAT\3.1\Boot\TEST_SuiteOverflow_Result.xml');
    
	Expected : BOOL;
	Actual	 : BOOL;
END_VAR
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    JunkResultFile.Initialize();

	// JunkResultFile<2> only has capacity for 3 suites; registering 5 distinct suites
	// forces JUnitResultFile.AddTestSuite() to overflow and increment SuiteOverflowCount.
	FOR i := 0 TO 4 DO
		JunkResultFile.AddTestSuite(CONCAT('OverflowSuite_', TO_STRING(i)));
	END_FOR

	Expected := TRUE;
	Actual	 := JunkResultFile.SuiteOverflowCount > 0;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>