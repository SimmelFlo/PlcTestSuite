	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Order_4" Id="{b1e27384-df90-44f6-a0a7-2a3b4c5d6e78}">
      <Declaration><![CDATA[METHOD Test_Order_4
VAR_INST
	Expected  : DINT;
	Actual	  : DINT;
