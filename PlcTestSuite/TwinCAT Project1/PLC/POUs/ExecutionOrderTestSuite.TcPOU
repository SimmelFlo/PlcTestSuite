END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Order_5" Id="{c2f38495-e0a1-4507-b1b8-3b4c5d6e7f89}">
      <Declaration><![CDATA[METHOD Test_Order_5
VAR_INST
	Expected  : DINT;
	Actual	  : DINT;
	ScanCount : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	IF ScanCount = 0 THEN
		BeginTest(5);
